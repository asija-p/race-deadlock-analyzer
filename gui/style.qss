QMainWindow {
    background-color: #f5f6fa;
}

QPushButton {
    background-color: #4a69bd;
    color: white;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #6a89cc;
}

QPushButton:pressed {
    background-color: #3c56a0;
}

QPlainTextEdit, QTextEdit {
    background-color: white;
    border: 1px solid #dcdde1;
    border-radius: 6px;
    padding: 6px;
}

QLabel {
    font-size: 11pt;
    color: #2f3640;
}

QSplitter::handle {
    background-color: #dcdde1;
}